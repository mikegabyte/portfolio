---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { t, localizePath, type Lang } from '../../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tt = t[lang].blog;

// Posts live under blog/<lang>/<slug>.md, so the collection id is prefixed
// with the locale. Show only this locale's posts; the URL slug drops the prefix.
const posts = (
  await getCollection('blog', ({ id, data }) => !data.draft && id.startsWith(`${lang}/`))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const slugOf = (id: string) => id.replace(/^(en|vi)\//, '');

const dateFmt = new Intl.DateTimeFormat(lang === 'vi' ? 'vi-VN' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Layout lang={lang} title={tt.title} description={tt.description}>
  <section class="py-6">
    <p class="font-mono text-sm text-amber-600" data-reveal>{tt.kicker}</p>
    <h1 class="mt-3 text-3xl font-bold text-stone-900" data-reveal>{tt.heading}</h1>
    <p class="mt-4 max-w-xl leading-relaxed text-stone-600" data-reveal set:html={tt.introHtml} />

    {
      posts.length === 0 ? (
        <div class="mt-8 rounded-lg border border-dashed border-stone-300 p-8 text-center font-mono text-sm text-stone-400">
          {tt.empty}
        </div>
      ) : (
        <ul class="mt-8 space-y-3" data-reveal-group>
          {posts.map((post) => (
            <li data-reveal-item>
              <a
                href={localizePath(lang, `/blog/${slugOf(post.id)}`)}
                class="group block rounded-lg border border-stone-200 bg-white/80 p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-amber-500/50 hover:shadow-md"
              >
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-stone-400">
                  <time datetime={post.data.date.toISOString()}>{dateFmt.format(post.data.date)}</time>
                  {post.data.series && (
                    <span class="rounded-full border border-amber-500/40 bg-amber-50 px-2 py-0.5 text-amber-700">
                      {post.data.series}
                      {post.data.seriesPart ? ` · ${tt.part} ${post.data.seriesPart}` : ''}
                    </span>
                  )}
                </div>
                <h2 class="mt-2 text-lg font-semibold text-stone-900 transition-colors group-hover:text-amber-700">
                  {post.data.title}
                </h2>
                <p class="mt-1 leading-relaxed text-stone-600">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>
