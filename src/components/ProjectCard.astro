---
import type { Project } from '../data/projects';
import { t, type Lang } from '../i18n/translations';

interface Props {
  project: Project;
  lang?: Lang;
}

const { project, lang = 'en' } = Astro.props;

const statusStyle: Record<Project['status'], string> = {
  shipped: 'border-emerald-500/40 bg-emerald-50 text-emerald-700',
  'in-progress': 'border-amber-500/50 bg-amber-50 text-amber-700',
  planned: 'border-sky-500/40 bg-sky-50 text-sky-700',
  professional: 'border-stone-300 bg-stone-100 text-stone-500',
};
---

<article
  class="tilt-card group relative rounded-lg border border-stone-200 bg-white p-5 shadow-sm hover:border-amber-500/50 hover:shadow-md"
  data-tilt
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold text-stone-900">
      {
        project.link ? (
          <a href={project.link} class="transition-colors group-hover:text-amber-700">
            {project.title}
          </a>
        ) : (
          project.title
        )
      }
    </h3>
    <span class:list={['shrink-0 rounded-full border px-2.5 py-0.5 font-mono text-xs', statusStyle[project.status]]}>
      {t[lang].status[project.status]}
    </span>
  </div>
  <p class="mt-2 leading-relaxed text-stone-600">{project.description[lang]}</p>
  <p class="mt-3 font-mono text-xs text-stone-400">
    {project.stack.join(' · ')}
  </p>
</article>
